# --- CONEXIÓN A BASE DE DATOS ---
DB_NAME=fichaje_cti
DB_USERNAME=postgres
DB_PASSWORD=mypass
DB_HOST=postgres_bbdd  # Nombre del contenedor PostgreSQL
DB_PORT=5432

# --- CONFIGURACIÓN DE LA APLICACIÓN ---
NODE_ENV=development
APP_PORT=3000
PORT=3000
CORS_ORIGIN=http://localhost:3567
TZ=Europe/Madrid

# --- JWT (SEGURIDAD) ---
