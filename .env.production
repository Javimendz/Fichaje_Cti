# --- CONFIGURACIÓN DE BASE DE DATOS ---
DB_PASSWORD=mypass
DB_NAME=fichaje_cti
DB_USERNAME=postgres
DB_PORT=5432
DB_HOST=postgres_db_prod  # Nombre del servicio en docker-compose

# --- CONFIGURACIÓN DE APP / VPS ---
PORT=3000
#Cambiar cuando estes en produccion descomentar linea
#NODE_ENV=production
NODE_ENV=development
# URL real de tu frontend (importante para el CORS que configuramos)
CORS_ORIGIN=http://cworker1.cticontrol.com:3567
TZ=Europe/Madrid


JWT_SECRET=tu_secreto_para_access
# Opcional: puedes usar un secreto distinto para el refresh por seguridad
JWT_REFRESH_SECRET=tu_secreto_para_refresh
# --- SEGURIDAD Y LÓGICA ---
SEED_SECRET_KEY=123
MAX_FICHAR_DISTANCE=600
DEFAULT_DAYS_ISSUES=5
DEFAULT_DAYS_REQUESTS=15