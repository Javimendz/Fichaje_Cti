# --- CONFIGURACIÓN DE PRODUCCIÓN - Fichaje CTI ---

# --- CONEXIÓN A BASE DE DATOS ---
DB_HOST=postgres
DB_USERNAME=postgres
DB_PASSWORD=mypass
DB_NAME=fichaje_cti
DB_PORT=5432

# --- CONFIGURACIÓN DE LA APLICACIÓN ---
NODE_ENV=development
APP_PORT=3000
CORS_ORIGIN=http://cworker1.cticontrol.com:3567
TZ=Europe/Madrid

# --- JWT (SEGURIDAD) ---
JWT_SECRET=tu_secreto_para_access
JWT_REFRESH_SECRET=tu_secreto_para_refresh
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# --- SEGURIDAD Y LÓGICA ---
SEED_SECRET_KEY=123
MAX_FICHAR_DISTANCE=600
DEFAULT_DAYS_ISSUES=5
DEFAULT_DAYS_REQUESTS=15

# --- pgAdmin (solo mantenimiento) ---
PGADMIN_EMAIL=admin@cticontrol.com
PGADMIN_PASSWORD=admin123_prod
PGADMIN_PORT=5050

# --- NGINX (opcional) ---
NGINX_PORT=80
NGINX_SSL_PORT=443
