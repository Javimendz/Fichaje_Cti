# --- CONFIGURACIÓN DE BASE DE DATOS ---
DB_USERNAME=postgres
DB_PASSWORD=mypass
DB_NAME=fichaje_cti
DB_PORT=5432

# --- CONFIGURACIÓN DE LA APLICACIÓN ---
NODE_ENV=development
APP_PORT=3000
CORS_ORIGIN=http://localhost:3567
TZ=Europe/Madrid

# --- JWT (SEGURIDAD) ---
JWT_SECRET=tu_secreto_para_access
JWT_REFRESH_SECRET=tu_secreto_para_refresh

# --- SEGURIDAD Y LÓGICA ---
SEED_SECRET_KEY=123
MAX_FICHAR_DISTANCE=600
DEFAULT_DAYS_ISSUES=5
DEFAULT_DAYS_REQUESTS=15

# --- pgAdmin (opcional) ---
PGADMIN_EMAIL=admin@cticontrol.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
