# =======================================================
# --- CONFIGURACIÓN DE PRODUCCIÓN - FICHAJE CTI ---
# =======================================================

# --- CONEXIÓN A BASE DE DATOS ---
# Importante: El host es 'postgres' porque así se llama el servicio en Docker
DB_HOST=postgres
DB_USERNAME=postgres
DB_PASSWORD=mypass  # 👈 CAMBIA ESTO
DB_NAME=fichaje_cti
DB_PORT=5432

# --- CONFIGURACIÓN DE LA APLICACIÓN ---
NODE_ENV=developtment                                  # 👈 CAMBIADO de development a production
APP_PORT=3000
CORS_ORIGIN=http://cworker1.cticontrol.com           # 👈 Quitamos el puerto :3567 (Nginx usa el 80)
TZ=Europe/Madrid

# --- JWT (SEGURIDAD) ---
# Usa cadenas largas y aleatorias para los secretos
JWT_SECRET=tu_secreto_para_access     # 👈 CAMBIA ESTO
JWT_REFRESH_SECRET=tu_secreto_para_refresh # 👈 CAMBIA ESTO
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# --- SEGURIDAD Y LÓGICA ---
SEED_SECRET_KEY=123        # 👈 CAMBIA EL '123' (Es tu llave maestra)
MAX_FICHAR_DISTANCE=600
DEFAULT_DAYS_ISSUES=5
DEFAULT_DAYS_REQUESTS=15

# --- pgAdmin (Mantenimiento) ---
# Nota: En producción, considera no levantar pgAdmin a menos que sea necesario
PGADMIN_DEFAULT_EMAIL=admin@cticontrol.com
PGADMIN_DEFAULT_PASSWORD=ClaveAdminPro_2026!          # 👈 CAMBIA ESTO
PGADMIN_PORT=5050

# --- NGINX ---
NGINX_PORT=80
NGINX_SSL_PORT=443