# --- CONFIGURACIÓN DE BASE DE DATOS ---
DB_USERNAME=postgres
DB_PASSWORD=mypass
DB_NAME=fichaje_db
# IMPORTANTE: Este nombre debe ser el que pongas en 'services:' del docker-compose.db.yaml
DB_HOST=postgres_db  
DB_PORT=5432

# --- CONFIGURACIÓN DE APP / VPS ---
APP_PORT=3000
# Si usas el puerto 80 en el docker-compose, quita el :3000 de aquí abajo
CORS_ORIGIN=http://cworker1.cticontrol.com:3567
#Para produccion poner la linea de abajo, para eliminar el synchronize
#NODE_ENV=production
NODE_ENV=development # esta linea crea la bd

# --- SEGURIDAD ---
SEED_SECRET_KEY=123
MAX_FICHAR_DISTANCE=600
DEFAULT_DAYS_ISSUES=5
DEFAULT_DAYS_REQUESTS=15

# --- REGIONAL ---
TZ=Europe/Madrid